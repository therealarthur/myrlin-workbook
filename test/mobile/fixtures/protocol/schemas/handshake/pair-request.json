{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/handshake/pair-request.json",
  "title": "PairRequest",
  "description": "POST /api/m/v2/pair (public). Signed by K_d with purpose pair-request. PROTOCOL.md 2.4 step 3.",
  "type": "object",
  "properties": {
    "offerId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/OfferId"
        },
        {
          "type": "null"
        }
      ]
    },
    "secretKind": {
      "type": "string",
      "enum": [
        "qr",
        "code"
      ]
    },
    "secret": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_-]{43}|[0-9ABCDEFGHJKMNPQRSTVWXYZ]{8})$"
    },
    "devicePublicKey": {
      "$ref": "../common/defs.json#/$defs/PublicKey"
    },
    "deviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\r\\n]+$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "osVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "deviceNonce": {
      "$ref": "../common/defs.json#/$defs/Nonce"
    },
    "ts": {
      "$ref": "../common/defs.json#/$defs/TimestampMs"
    },
    "sig": {
      "$ref": "../common/defs.json#/$defs/Signature"
    }
  },
  "required": [
    "offerId",
    "secretKind",
    "secret",
    "devicePublicKey",
    "deviceName",
    "model",
    "osVersion",
    "appVersion",
    "deviceNonce",
    "ts",
    "sig"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "secretKind": {
            "const": "code"
          }
        }
      },
      "then": {
        "properties": {
          "offerId": {
            "type": "null"
          },
          "secret": {
            "type": "string",
            "pattern": "^[0-9ABCDEFGHJKMNPQRSTVWXYZ]{8}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "secretKind": {
            "const": "qr"
          }
        }
      },
      "then": {
        "properties": {
          "offerId": {
            "$ref": "../common/defs.json#/$defs/OfferId"
          },
          "secret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    }
  ]
}
