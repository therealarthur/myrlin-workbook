{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/accounts/swap-request.json",
  "title": "SwapRequest",
  "description": "POST /api/m/v2/accounts/swap. PROTOCOL.md 4.11.",
  "type": "object",
  "properties": {
    "clientRequestId": {
      "$ref": "../common/defs.json#/$defs/Uuid"
    },
    "provider": {
      "$ref": "../common/defs.json#/$defs/Provider"
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "force": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "user",
        "undo",
        "best"
      ]
    }
  },
  "required": [
    "clientRequestId",
    "provider",
    "accountId",
    "force",
    "reason"
  ],
  "additionalProperties": false
}
