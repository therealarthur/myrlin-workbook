{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/events/message.update.json",
  "title": "Event message.update",
  "description": "The message.update event with its envelope. PROTOCOL.md 5.4 and 7.3.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "pattern": "^session:(cl|cx|wb)_[A-Za-z0-9._:-]{1,120}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "message.update"
        },
        "data": {
          "type": "object",
          "properties": {
            "message": {
              "$ref": "../../sessions/message.json"
            },
            "replacesId": {
              "anyOf": [
                {
                  "$ref": "../../common/defs.json#/$defs/MessageId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "replacesId"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "topic",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
