{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/events/turn.start.json",
  "title": "Event turn.start",
  "description": "The turn.start event with its envelope. PROTOCOL.md 5.4 and 6.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "pattern": "^session:(cl|cx|wb)_[A-Za-z0-9._:-]{1,120}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "turn.start"
        },
        "data": {
          "$ref": "../../sessions/turn.json"
        }
      },
      "required": [
        "topic",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
