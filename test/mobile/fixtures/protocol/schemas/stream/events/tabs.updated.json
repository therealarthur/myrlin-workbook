{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/events/tabs.updated.json",
  "title": "Event tabs.updated",
  "description": "The tabs.updated event with its envelope. PROTOCOL.md 5.4 and 4.8.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "topic": {
          "const": "tabs"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabs.updated"
        },
        "data": {
          "type": "object",
          "properties": {
            "tabs": {
              "$ref": "../../workspace/tabs.json"
            },
            "changedBy": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "desktop",
                    "device"
                  ]
                },
                "deviceId": {
                  "anyOf": [
                    {
                      "$ref": "../../common/defs.json#/$defs/DeviceId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "deviceId"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "tabs",
            "changedBy"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "topic",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
