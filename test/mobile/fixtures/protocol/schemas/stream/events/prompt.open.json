{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/events/prompt.open.json",
  "title": "Event prompt.open",
  "description": "The prompt.open event with its envelope. PROTOCOL.md 5.4 and 8.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "pattern": "^session:(cl|cx|wb)_[A-Za-z0-9._:-]{1,120}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "prompt.open"
        },
        "data": {
          "type": "object",
          "properties": {
            "prompt": {
              "$ref": "../../sessions/prompt.json"
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "topic",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
