      "$ref": "../common/defs.json#/$defs/Provider"
    },
    "schemaRevision": {
      "type": "integer",
      "minimum": 1
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "pendingRestart": {
      "type": "boolean"
    },
    "canRestartNow": {
      "type": "boolean"
    }
  },
  "required": [
    "sessionId",
    "provider",
    "schemaRevision",
    "values",
    "pendingRestart",
    "canRestartNow"
