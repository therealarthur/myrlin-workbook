{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/sessions/session-settings.json",
  "title": "SessionSettings",
  "description": "GET and PATCH answer of /api/m/v2/sessions/:sessionId/settings. PROTOCOL.md 4.5.3.",
  "type": "object",
  "properties": {
