{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/sessions/new-session-request.json",
  "title": "NewSessionRequest",
  "description": "POST /api/m/v2/sessions: launch without a socket. PROTOCOL.md 4.5.6.",
  "type": "object",
  "properties": {
    "clientRequestId": {
      "$ref": "../common/defs.json#/$defs/Uuid"
    },
    "provider": {
      "$ref": "../common/defs.json#/$defs/Provider"
    },
    "workingDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "null"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tabGroupId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "afterSessionId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/SessionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "$ref": "./send-request.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "clientRequestId",
    "provider",
    "workingDir",
    "projectId",
    "name",
    "settings",
    "tabGroupId",
    "afterSessionId",
    "message"
  ],
  "additionalProperties": false
}
