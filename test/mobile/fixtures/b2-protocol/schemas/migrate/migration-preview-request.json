{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/migrate/migration-preview-request.json",
  "title": "MigrationPreviewRequest",
  "description": "POST /api/m/v2/sessions/:sessionId/migrations/preview. PROTOCOL.md 4.12.1.",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "../common/defs.json#/$defs/Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "depth": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "quick",
            "standard",
            "exhaustive"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "takeover",
            "fork"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fromMessageId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/MessageId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "target",
    "depth",
    "mode",
    "fromMessageId"
  ],
  "additionalProperties": false
}
