{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/migrate/migration-start-request.json",
  "title": "MigrationStartRequest",
  "description": "POST /api/m/v2/sessions/:sessionId/migrations (Idempotency-Key header required). PROTOCOL.md 4.12.2.",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "../common/defs.json#/$defs/Provider"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "accountId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "effort",
        "accountId"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "takeover",
        "fork"
      ]
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "exhaustive"
      ]
    },
    "focus": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "sourcePolicy": {
      "type": "string",
      "enum": [
        "pause",
        "leave"
      ]
    },
    "readerModel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "tabGroupId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "startWhileBusy": {
      "type": "boolean"
    },
    "confirmCost": {
      "type": "boolean"
    },
    "fromMessageId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/MessageId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "target",
    "mode",
    "depth",
    "focus",
    "sourcePolicy",
    "readerModel",
    "name",
    "tabGroupId",
    "startWhileBusy",
    "confirmCost",
    "fromMessageId"
  ],
  "additionalProperties": false
}
