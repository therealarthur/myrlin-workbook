{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/migrate/migrations-list.json",
  "title": "MigrationList",
  "description": "GET /api/m/v2/migrations (snapshot of topic migrations). PROTOCOL.md 4.12.3.",
  "type": "object",
  "properties": {
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "./migration.json"
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/Cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "streamEpoch": {
      "$ref": "../common/defs.json#/$defs/StreamEpoch"
    },
    "streamSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "migrations",
    "nextCursor",
    "streamEpoch",
    "streamSeq"
  ],
  "additionalProperties": true
}
