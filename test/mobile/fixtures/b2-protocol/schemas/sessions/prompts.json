{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/sessions/prompts.json",
  "title": "PromptList",
  "description": "GET /api/m/v2/sessions/:sessionId/prompts. PROTOCOL.md 4.4.7.",
  "type": "object",
  "properties": {
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "./prompt.json"
      }
    },
    "streamEpoch": {
      "$ref": "../common/defs.json#/$defs/StreamEpoch"
    },
    "streamSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "prompts",
    "streamEpoch",
    "streamSeq"
  ],
  "additionalProperties": true
}
