{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/sessions/recent-sessions.json",
  "title": "RecentSessions",
  "description": "GET /api/m/v2/sessions/recent (snapshot of topic sessions). PROTOCOL.md 4.4.1.",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "./session-summary.json"
      },
      "maxItems": 200
    },
    "nextCursor": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/Cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "partial": {
      "type": "boolean"
    },
    "streamEpoch": {
      "$ref": "../common/defs.json#/$defs/StreamEpoch"
    },
    "streamSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "sessions",
    "nextCursor",
    "partial",
    "streamEpoch",
    "streamSeq"
  ],
  "additionalProperties": true
}
