{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/sessions/branch-request.json",
  "title": "BranchRequest",
  "description": "POST /api/m/v2/sessions/:sessionId/branch: a native same provider fork. Answered with NewSessionResult. PROTOCOL.md 4.5.8.",
  "type": "object",
  "properties": {
    "clientRequestId": {
      "$ref": "../common/defs.json#/$defs/Uuid"
    },
    "fromMessageId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/MessageId"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\r\\n]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tabGroupId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "afterSessionId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/SessionId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "clientRequestId",
    "fromMessageId",
    "name",
    "tabGroupId",
    "afterSessionId"
  ],
  "additionalProperties": false
}
