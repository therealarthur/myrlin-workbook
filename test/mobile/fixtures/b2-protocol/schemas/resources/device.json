{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/resources/device.json",
  "title": "Device",
  "description": "This phone as the computer knows it. GET /api/m/v2/devices/me. PROTOCOL.md 3.3.",
  "type": "object",
  "properties": {
    "deviceId": {
      "$ref": "../common/defs.json#/$defs/DeviceId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model": {
      "type": "string"
    },
    "osVersion": {
      "type": "string"
    },
    "appVersion": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "../common/defs.json#/$defs/Scope"
      },
      "uniqueItems": true
    },
    "pairedAtMs": {
      "$ref": "../common/defs.json#/$defs/TimestampMs"
    },
    "lastSeenAtMs": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/TimestampMs"
        },
        {
          "type": "null"
        }
      ]
    },
    "push": {
      "type": "object",
      "properties": {
        "registered": {
          "type": "boolean"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "sandbox",
                "production"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAtMs": {
          "anyOf": [
            {
              "$ref": "../common/defs.json#/$defs/TimestampMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "liveActivityTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "registered",
        "environment",
        "updatedAtMs",
        "liveActivityTokens"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "deviceId",
    "name",
    "model",
    "osVersion",
    "appVersion",
    "scopes",
    "pairedAtMs",
    "lastSeenAtMs",
    "push"
  ],
  "additionalProperties": true
}
