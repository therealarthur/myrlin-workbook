{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/notice.json",
  "title": "Notice",
  "description": "A computer notice; the data of computer.notice carries it. PROTOCOL.md 3.13.",
  "type": "object",
  "properties": {
    "noticeId": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/SessionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "accountId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAtMs": {
      "$ref": "../common/defs.json#/$defs/TimestampMs"
    },
    "expiresAtMs": {
      "anyOf": [
        {
          "$ref": "../common/defs.json#/$defs/TimestampMs"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "noticeId",
    "level",
    "code",
    "message",
    "sessionId",
    "accountId",
    "createdAtMs",
    "expiresAtMs"
  ],
  "additionalProperties": true
}
