{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/envelope.json",
  "title": "StreamEnvelope",
  "description": "Every server frame on /ws/m/v2: events and $control frames. PROTOCOL.md 5.3.",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^(\\$control|computer|device|sessions|tabs|accounts|migrations|session:(cl|cx|wb)_[A-Za-z0-9._:-]{1,120})$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "$ref": "../common/defs.json#/$defs/StreamEpoch"
    },
    "ts": {
      "$ref": "../common/defs.json#/$defs/TimestampMs"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "topic",
    "seq",
    "epoch",
    "ts",
    "type",
    "data"
  ],
  "additionalProperties": true
}
