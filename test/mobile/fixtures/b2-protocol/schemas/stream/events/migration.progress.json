{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/events/migration.progress.json",
  "title": "Event migration.progress",
  "description": "The migration.progress event with its envelope. PROTOCOL.md 5.4 and 4.12.5.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "topic": {
          "const": "migrations"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "migration.progress"
        },
        "data": {
          "type": "object",
          "properties": {
            "migration": {
              "$ref": "../../migrate/migration.json"
            }
          },
          "required": [
            "migration"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "topic",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
