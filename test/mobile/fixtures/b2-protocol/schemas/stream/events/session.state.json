{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrlin.io/protocol/v2/schemas/stream/events/session.state.json",
  "title": "Event session.state",
  "description": "The session.state event with its envelope. PROTOCOL.md 5.4 and 6.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "pattern": "^session:(cl|cx|wb)_[A-Za-z0-9._:-]{1,120}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "session.state"
        },
        "data": {
          "$ref": "../../sessions/session-state.json"
        }
      },
      "required": [
        "topic",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
