{
  "name": "myrlin-workbook",
  "version": "1.3.0-alpha.31",
  "description": "Browser-based project manager for AI coding assistants (Claude Code, ChatGPT Codex). Multi-provider session discovery, search, live terminals, docs, kanban, themes.",
  "main": "src/index.js",
  "bin": {
    "myrlin-workbook": "./src/gui.js",
    "myrlin": "./src/gui.js",
    "myrlin-tui": "./src/index.js",
    "cwm": "./src/index.js"
  },
  "files": [
    "src/",
    "!src/web/public/.backup",
    "!src/web/public/.backup/**",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "demo": "node src/demo.js",
    "gui": "node src/supervisor.js",
    "gui:daemon": "node src/supervisor.js --daemon",
    "gui:bare": "node src/gui.js",
    "gui:demo": "node src/supervisor.js --demo",
    "test": "node test/run.js",
    "test:browser": "npm run test:terminal-browser && npm run test:workbook-shell && npm run test:notion-shell && npm run test:history-e2e",
    "test:terminal-browser": "node test/browser/terminal-interaction.test.js",
    "test:workbook-shell": "node test/browser/workbook-shell.test.js",
    "test:notion-shell": "node test/browser/notion-shell.spec.js",
    "test:history-e2e": "node test/browser/terminal-history-e2e.test.js",
    "test:mobile-terminal": "node test/browser/mobile-terminal.spec.js",
    "gates": "node scripts/do-not-break-gates.js",
    "mcp:visual-qa": "node src/mcp/visual-qa.js",
    "gui:cdp": "node src/supervisor.js --cdp",
    "postinstall": "node scripts/postinstall.js",
    "restart": "bash scripts/restart-gui.sh",
    "build:icons": "node scripts/build-lucide-bundle.mjs && node scripts/build-material-bundle.mjs",
    "brand:build": "node scripts/brand/build-icons.js && node scripts/brand/build-logo-anim.js",
    "brand:review": "node scripts/brand/build-review-sheet.js",
    "media:capture": "node scripts/media/capture.js",
    "media:encode": "node scripts/media/encode.js",
    "media:stills": "node scripts/media/stills.js",
    "media:ads": "node scripts/media/ads.js",
    "media:all": "npm run media:capture && npm run media:encode && npm run media:stills && npm run media:ads"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/therealarthur/myrlin-workbook.git"
  },
  "homepage": "https://github.com/therealarthur/myrlin-workbook",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "chatgpt",
    "openai",
    "multi-provider",
    "workspace",
    "manager",
    "terminal",
    "tui",
    "ai",
    "coding-assistant",
    "session-manager",
    "developer-tools",
    "xterm",
    "myrlin"
  ],
  "author": "Arthur",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@lucide/lab": "^0.2.0",
    "@xterm/headless": "^6.0.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "chrome-remote-interface": "^0.34.0",
    "express": "^5.2.1",
    "lucide": "^1.8.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.33.0",
    "sql.js": "^1.14.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@material-icons/svg": "^1.0.33",
    "@playwright/test": "^1.62.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "xml2js": "^0.6.2"
  }
}
