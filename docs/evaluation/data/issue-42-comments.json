[{"url":"https://api.github.com/repos/therealarthur/myrlin-workbook/issues/comments/4227172141","html_url":"https://github.com/therealarthur/myrlin-workbook/issues/42#issuecomment-4227172141","issue_url":"https://api.github.com/repos/therealarthur/myrlin-workbook/issues/42","id":4227172141,"node_id":"IC_kwDORJ757c779Yct","user":{"login":"therealarthur","id":17861084,"node_id":"MDQ6VXNlcjE3ODYxMDg0","avatar_url":"https://avatars.githubusercontent.com/u/17861084?v=4","gravatar_id":"","url":"https://api.github.com/users/therealarthur","html_url":"https://github.com/therealarthur","followers_url":"https://api.github.com/users/therealarthur/followers","following_url":"https://api.github.com/users/therealarthur/following{/other_user}","gists_url":"https://api.github.com/users/therealarthur/gists{/gist_id}","starred_url":"https://api.github.com/users/therealarthur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/therealarthur/subscriptions","organizations_url":"https://api.github.com/users/therealarthur/orgs","repos_url":"https://api.github.com/users/therealarthur/repos","events_url":"https://api.github.com/users/therealarthur/events{/privacy}","received_events_url":"https://api.github.com/users/therealarthur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-10T22:38:39Z","updated_at":"2026-04-10T22:38:39Z","body":"Thanks for reporting @hybridandrew! Found the issue.\n\nThe upload directory was saved relative to the npm package location (`<project-root>/uploads/`). When running via `npx`, that path points to an ephemeral cache directory that Claude Code can't reliably access, and the path doesn't survive restarts.\n\nFixed in v0.9.25. Images now save to `~/.myrlin/uploads/<sessionId>/`, which is the same stable data directory used for all Myrlin state. The absolute path sent to Claude will always be accessible.\n\nUpdate with `npx myrlin-workbook@latest`.\n\nNote: copy-pasting images directly into the terminal isn't supported since xterm.js is a text-only terminal. Use the upload button (camera icon) on the pane header, or drag an image onto the pane.","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/therealarthur/myrlin-workbook/issues/comments/4227172141/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null},{"url":"https://api.github.com/repos/therealarthur/myrlin-workbook/issues/comments/4230683097","html_url":"https://github.com/therealarthur/myrlin-workbook/issues/42#issuecomment-4230683097","issue_url":"https://api.github.com/repos/therealarthur/myrlin-workbook/issues/42","id":4230683097,"node_id":"IC_kwDORJ757c78KxnZ","user":{"login":"hybridandrew","id":191410389,"node_id":"U_kgDOC2iw1Q","avatar_url":"https://avatars.githubusercontent.com/u/191410389?v=4","gravatar_id":"","url":"https://api.github.com/users/hybridandrew","html_url":"https://github.com/hybridandrew","followers_url":"https://api.github.com/users/hybridandrew/followers","following_url":"https://api.github.com/users/hybridandrew/following{/other_user}","gists_url":"https://api.github.com/users/hybridandrew/gists{/gist_id}","starred_url":"https://api.github.com/users/hybridandrew/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hybridandrew/subscriptions","organizations_url":"https://api.github.com/users/hybridandrew/orgs","repos_url":"https://api.github.com/users/hybridandrew/repos","events_url":"https://api.github.com/users/hybridandrew/events{/privacy}","received_events_url":"https://api.github.com/users/hybridandrew/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-12T03:52:02Z","updated_at":"2026-04-12T03:52:02Z","body":"sorry, but I updated and it didnt work:\n\n<img width=\"646\" height=\"87\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/126f7b9e-5a19-4f4a-ae77-1c2dc93201b